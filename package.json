{
  "name": "aws-cli-tui",
  "version": "0.1.1",
  "description": "Search-first terminal UI for AWS CLI operations generated from public Smithy models",
  "type": "module",
  "bin": {
    "awstui": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/model/generated/catalog.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "models:generate": "node scripts/generate-catalog.mjs",
    "start": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^6.6.0",
    "react": "^19.2.3",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
